<?xml version="1.0"?>
<!-- robot_leg 的仿真薄壳：include 同目录的纯模型 URDF，注入 ros2_control 与 gz_ros2_control 插件。
     机械几何/惯量/关节原点与轴全部来自 urdf/robot_leg.urdf（派生自 cad/ 的 sw2urdf 导出件），
     本文件只加仿真侧的东西，不改机械模型。

     仅导出 effort 命令接口：同时导出 position 与 effort 会使 gz-sim 忽略位置命令。
     不支持 control_mode:=position，控制器加载会失败。

     参数：
       controllers_file  控制器参数文件（launch 按模型目录传入）
       fixed_base        true（默认）= 把 base_link 焊到世界原点
       gravity           true（默认）= 连杆保留 Gazebo 重力；纯运动学验收可设 false

     ⚠ 接触摩擦 0.8 是估计值，未标定；关节限位/力矩/速度见 README 的「关节限位与
     effort/velocity」，其中限位是占位值。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_leg">
  <xacro:arg name="controllers_file"
             default="$(find robot_description)/models/robot_leg/config/controllers.yaml"/>
  <xacro:arg name="fixed_base" default="true"/>
  <xacro:arg name="gravity" default="true"/>

  <xacro:include filename="robot_leg.urdf"/>

  <xacro:if value="$(arg fixed_base)">
    <link name="world"/>
    <joint name="world_to_base_link" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="base_link"/>
    </joint>
  </xacro:if>

  <!-- 力矩控制关节接口：只有 effort 命令接口；状态含 effort，仿真里可直接读关节力矩。 -->
  <xacro:macro name="torque_control_joint" params="name">
    <joint name="${name}">
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- 声明顺序必须与 URDF 的物理关节顺序一致（由 test_model_consistency.py 兜底）。 -->
  <ros2_control name="robot_leg_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:torque_control_joint name="joint_link1"/>
    <xacro:torque_control_joint name="joint_link2"/>
    <xacro:torque_control_joint name="joint_link3"/>
    <xacro:torque_control_joint name="joint_link4"/>
    <xacro:torque_control_joint name="joint_link5"/>
    <xacro:torque_control_joint name="joint_link6"/>
  </ros2_control>

  <!-- 接触摩擦：mu1/mu2 = 0.8（铝/塑料件干摩擦的量级估计，未标定）。
       ⚠ dartsim 不读 <ode><kp>/<kd>，故不写，免得看起来配了其实无效。 -->
  <xacro:macro name="link_surface" params="link">
    <gazebo reference="${link}">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <gravity>$(arg gravity)</gravity>
    </gazebo>
  </xacro:macro>

  <xacro:link_surface link="base_link"/>
  <xacro:link_surface link="Joint_link1"/>
  <xacro:link_surface link="Joint_link2"/>
  <xacro:link_surface link="Joint_link3"/>
  <xacro:link_surface link="Joint_link4"/>
  <xacro:link_surface link="Joint_link5"/>
  <xacro:link_surface link="Joint_link6"/>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
