<?xml version="1.0"?>
<!-- zhoubuguanjie_youbi_001 的仿真薄壳：引入 SolidWorks 导出的原始 URDF，注入 ros2_control
     与 gz_ros2_control 插件。display.launch.py 直接加载 urdf（无需控制器），
     gazebo.launch.py 加载本文件。

     模型共 14 个关节：12 个 revolute + 2 个 fixed（joint_link10/10_0，电机锁在轴承座上）。
     12 个 revolute = joint_link1..6 主链 + 两条腕部分支
     （joint_wrist_ball_a → joint_link7 → joint_link9 与 _b/_0 那条）。
     其中 joint_wrist_ball_a/_b 是**虚拟**关节：真实连杆两端都是关节轴承（球铰），
     SolidWorks 树导出只能给单轴 revolute，于是各补一个正交 revolute 与零质量虚拟连杆
     构成二自由度球铰（见 urdf/*.urdf 注释与 README 的腕部章节）。它们没有电机，
     被动角由 scripts/wrist_closure_solver.py 按闭环约束解出。
     <ros2_control> 声明全部 12 个 revolute（顺序 = URDF 物理关节顺序）；控制器只接管
     当前接入电机拓扑的肩肘 4 个关节（见 config/controllers.yaml），腕部关节有状态接口、
     无命令控制器，在 Gazebo 里按被动动力学运动。

     参数：
       controllers_file  控制器参数文件（gazebo.launch.py 按模型目录传入）
       fixed_base        true（默认）= 把 base_link 焊到世界原点：真机上这条臂是固定在
                         台面上的，焊死后基座不再依赖地面接触摩擦来保持不动，行为可复现。
                         实测 false（自由浮动基座）在现有命令范围内也没有明显漂移，但那时
                         基座姿态由接触求解决定，不适合当基准。
       gravity           true（默认）= 保留 Gazebo 重力；position 模式做通信/轨迹验收时
                         可设 false，避免未建模的重力补偿影响位置闭环。

     模型目录是自包含的：include 用相对文件名（xacro 按被包含文件所在目录解析，见
     xacro/__init__.py:abs_filename_spec），整个目录拷进 models/ 即可新增一个模型，
     不需要改这个文件之外的任何东西。注意不能用 $(dirname)：它只在 ros2 launch 提供的
     文件上下文里可用，直接调 `xacro <file>`（本包的 launch 就是这种子进程方式）会报
     "no file/directory information available"。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zhoubuguanjie_youbi_001">
  <xacro:arg name="controllers_file"
             default="$(find robot_arm_gazebo)/models/zhoubuguanjie_youbi_001/config/controllers.yaml"/>
  <xacro:arg name="fixed_base" default="true"/>
  <xacro:arg name="gravity" default="true"/>

  <xacro:include filename="zhoubuguanjie_youbi_001.urdf"/>

  <xacro:if value="$(arg fixed_base)">
    <link name="world"/>
    <joint name="world_to_base_link" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="base_link"/>
    </joint>
  </xacro:if>

  <!-- 关节接口声明（position + effort 两条命令接口；position/velocity 状态）。
       effort 是给「MIT 驱动器替身」用的：真机上 CERB 在 MIT 模式下收 (p, v, kp, kd, τ)
       并自己算 τ = kp(p_des−p) + kd(v_des−v) + τ_ff；仿真里由 scripts/mit_gazebo_probe.py
       算同一个式子写进 effort 命令接口，于是插补的平滑度能在一个**带动力学的被控对象**
       上被看到（现有 CAN 模拟器不建模速度，看不出这件事）。
       两条命令接口不会同时 active——用 controller_manager 切换，见 config/controllers.yaml。
       宏名不带模型前缀，拷去新模型时不用改；声明顺序必须与 urdf 的物理关节顺序一致
       （由 test_model_consistency.py 兜底），控制器取其中子集。 -->
  <xacro:macro name="sim_control_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="zhoubuguanjie_youbi_001_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:sim_control_joint name="joint_link1"/>
    <xacro:sim_control_joint name="joint_link2"/>
    <xacro:sim_control_joint name="joint_link3"/>
    <xacro:sim_control_joint name="joint_link4"/>
    <xacro:sim_control_joint name="joint_link5"/>
    <xacro:sim_control_joint name="joint_link6"/>
    <xacro:sim_control_joint name="joint_wrist_ball_a"/>
    <xacro:sim_control_joint name="joint_link7"/>
    <xacro:sim_control_joint name="joint_link9"/>
    <xacro:sim_control_joint name="joint_wrist_ball_b"/>
    <xacro:sim_control_joint name="joint_link7_0"/>
    <xacro:sim_control_joint name="joint_link9_0"/>
  </ros2_control>

  <!-- FDCAN 仿真器的 position 模式是通信/轨迹闭环验收，不包含重力补偿；
       由 launch 的 gravity:=false 显式关闭各活动连杆重力。默认仍保留物理模型重力，
       effort 模式与原有动力学测试不被改变。腕部连杆（Joint_link7 之后）物理上由
       两台 X25S 电机经摇臂驱动并构成闭环，URDF 树只保留切开的一支（见 README），
       它们活重力下会按被动连杆摆动。 -->
  <gazebo reference="Joint_link1"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link2"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link3"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link4"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link5"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link6"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link7"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link9"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link10"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link7_0"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link9_0"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link10_0"><gravity>$(arg gravity)</gravity></gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
