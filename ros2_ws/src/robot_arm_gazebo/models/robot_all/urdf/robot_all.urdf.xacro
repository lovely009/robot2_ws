<?xml version="1.0"?>
<!-- robot_all 的仿真薄壳：引入 SolidWorks 导出的上身 URDF，注入 ros2_control 与
     gz_ros2_control 插件。display.launch.py 直接加载 urdf（无需控制器），
     gazebo.launch.py 加载本文件。

     本模型是**双臂 18 轴**：base_link（躯干，网格 z ∈ [0.0000, 0.7029]）分出两条 9 轴链 ——
     第一链 Joint_link1..9（x ≈ +0.06 侧）与第二链 Joint_link1.1..9.9（x ≈ −0.05 侧，
     导出器给第二链的 link/joint 名加 `.N` 后缀）。全部是 revolute，0 个 fixed，两条链在
     URDF 里都是纯树（彼此不连），没有任何闭环，不需要补环节点。

     ⚠ 命名：link 是导出器原样的大写 `Joint_linkN` / `Joint_linkN.N`，
     joint 是小写 `joint_linkN` / `joint_linkN.N`。导出器原本让 joint 与它驱动的 link 同名 ——
     SDFormat 里 link 与 joint 共用 <model> 命名空间，同名会让模型在 Ignition 里建不起来
     （Non-unique name / FrameAttachedToGraph 环），故 joint 一律改小写。
     关节名里的 `.N` 后缀是导出器对第二链的编号（`joint_link7.7` = 第二链第 7 轴），
     不是数值/层级，语序与 `joint_link7` 无关。

     ⚠ link 与 joint 名都含点号：ROS 2 允许（tf frame_id、/joint_states 名都接受），
     但 shell 里给参数需加引号。

     <ros2_control> 声明全部 18 个 revolute（顺序 = URDF 物理关节顺序：第一链 1..9 →
     第二链 1.1..9.9）。端到端电机仿真（config/simulation_topology.yaml）只映射**第一链**
     的 9 个关节（joint_link1..9 ↔ chest_joint1..9 ↔ id 1..9，见本目录 config/），
     simulation.launch.py 会按该拓扑生成只含这 9 个关节的控制器配置；纯 Gazebo 的
     gazebo.launch.py 则用 config/controllers.yaml 接管全部 18 个。

     ⚠ **第二链没有电机**：它的 9 个连杆在 Gazebo 里恒关重力（见文件末尾的
     <gazebo reference>），否则会在重力下自由下垂（接上电机后应改回 $(arg gravity)）。
     第一链的 9 个连杆受 gravity 参数控制：position 模式做通信/轨迹验收时可设 false。

     参数：
       controllers_file  控制器参数文件（gazebo.launch.py 按模型目录传入）
       fixed_base        true（默认）= 把 base_link 焊到世界原点：座体固定在台面上，
                         焊死后基座不再依赖地面接触摩擦来保持不动，行为可复现。
       gravity           true（默认）= 第一链连杆保留 Gazebo 重力；对第一链做
                         position 轨迹验收时可设 false，避免未建模的重力补偿影响闭环。

     ⚠ 生成高度：base_link 网格 z ∈ [0.0000, 0.7029]，零位下全模型最低点恰为
     z = 0.000000，故 spawn_z 用 0.0（gazebo.launch.py 的默认值）。

     ⚠ 关节限位/力矩/速度是占位值（±1.5708 rad / 10 Nm / 1 rad/s），接真机前必须按实际
     机械限位与执行器参数替换。详见 model README.md。

     模型目录是自包含的：include 用相对文件名（xacro 按被包含文件所在目录解析），
     整个目录拷进 models/ 即可新增一个模型。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_all">
  <xacro:arg name="controllers_file"
             default="$(find robot_arm_gazebo)/models/robot_all/config/controllers.yaml"/>
  <xacro:arg name="fixed_base" default="true"/>
  <xacro:arg name="gravity" default="true"/>

  <xacro:include filename="robot_all.urdf"/>

  <xacro:if value="$(arg fixed_base)">
    <link name="world"/>
    <joint name="world_to_base_link" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="base_link"/>
    </joint>
  </xacro:if>

  <!-- 关节接口声明（position + effort 两条命令接口；position/velocity 状态）。
       两条命令接口不会同时 active —— 用 controller_manager 切换，见 config/controllers.yaml。
       声明顺序必须与 urdf 的物理关节顺序一致（由 test_model_consistency.py 兜底），
       控制器取其中子集。 -->
  <xacro:macro name="sim_control_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="robot_all_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- 第一链（x ≈ +0.06 侧） -->
    <xacro:sim_control_joint name="joint_link1"/>
    <xacro:sim_control_joint name="joint_link2"/>
    <xacro:sim_control_joint name="joint_link3"/>
    <xacro:sim_control_joint name="joint_link4"/>
    <xacro:sim_control_joint name="joint_link5"/>
    <xacro:sim_control_joint name="joint_link6"/>
    <xacro:sim_control_joint name="joint_link7"/>
    <xacro:sim_control_joint name="joint_link8"/>
    <xacro:sim_control_joint name="joint_link9"/>
    <!-- 第二链（x ≈ −0.05 侧，导出器 `.N` 后缀） -->
    <xacro:sim_control_joint name="joint_link1.1"/>
    <xacro:sim_control_joint name="joint_link2.2"/>
    <xacro:sim_control_joint name="joint_link3.3"/>
    <xacro:sim_control_joint name="joint_link4.4"/>
    <xacro:sim_control_joint name="joint_link5.5"/>
    <xacro:sim_control_joint name="joint_link6.6"/>
    <xacro:sim_control_joint name="joint_link7.7"/>
    <xacro:sim_control_joint name="joint_link8.8"/>
    <xacro:sim_control_joint name="joint_link9.9"/>
  </ros2_control>

  <!-- 第一链（joint_link1..9）有电机：重力由 gravity 参数控制（position 模式验收时可整体关闭）。 -->
  <gazebo reference="Joint_link1"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link2"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link3"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link4"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link5"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link6"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link7"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link8"><gravity>$(arg gravity)</gravity></gazebo>
  <gazebo reference="Joint_link9"><gravity>$(arg gravity)</gravity></gazebo>

  <!-- 第二链没有电机：恒关重力，避免无驱动自由下垂（接上电机后改回 $(arg gravity)）。 -->
  <gazebo reference="Joint_link1.1"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link2.2"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link3.3"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link4.4"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link5.5"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link6.6"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link7.7"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link8.8"><gravity>false</gravity></gazebo>
  <gazebo reference="Joint_link9.9"><gravity>false</gravity></gazebo>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
