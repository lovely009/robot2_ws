# Source time is the latest MCU-synchronized control snapshot header stamp.
std_msgs/Header header
uint64 session_id
MotorPolicyTarget[<=37] targets
---
# accepted means applied/queued; enabling still requires MCU state confirmation.
# An all-disabled request bypasses the generation/transaction queue and returns generation/request 0.
bool accepted
uint64 session_id
string<=31 intent_id
uint32 policy_generation
uint32 request_id
string<=63 reason
