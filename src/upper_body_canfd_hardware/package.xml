<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>upper_body_canfd_hardware</name>
  <version>0.1.0</version>
  <description>
    C++ ros2_control hardware interface for the upper-body CAN-FD motors:
    YiYou RP-series joints (MIT broadcast protocol) and 25/30 mm wrist drives
    (per-node MIT protocol).
  </description>
  <maintainer email="robot@example.com">Robot Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/upper_body_canfd_hardware.xml"/>
  </export>
</package>
