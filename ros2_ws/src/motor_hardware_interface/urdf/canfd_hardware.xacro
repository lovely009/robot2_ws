<?xml version="1.0"?>
<!-- CAN-FD ros2_control 硬件描述片段（与机器人拓扑无关）。

  供机器人模型 xacro include 使用：canfd_hardware 宏展开 CanFdSystem 插件与
  bus_override 参数（由 bus_overrides 字符串驱动，总线数量任意），
  canfd_control_joint 宏声明 position 命令 + 三态接口。
  关节清单由模型包提供，本片段不写死任何关节、数量或左右臂拓扑。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 递归展开 "总线名:接口,总线名:接口" 列表，逐个生成 bus_override 参数。 -->
  <xacro:macro name="emit_bus_overrides" params="pairs">
    <xacro:if value="${len(pairs) > 0}">
      <param name="bus_override.${pairs[0][0]}">${pairs[0][1]}</param>
      <xacro:emit_bus_overrides pairs="${pairs[1:]}" />
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="canfd_hardware"
               params="motor_config_file bus_overrides:=''">
    <hardware>
      <plugin>motor_hardware_interface/CanFdSystem</plugin>
      <xacro:emit_bus_overrides
          pairs="${[x.split(':') for x in bus_overrides.split(',') if x]}"/>
      <param name="config_file">${motor_config_file}</param>
    </hardware>
  </xacro:macro>

  <xacro:macro name="canfd_control_joint" params="joint">
    <joint name="${joint}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- 递归展开 "关节名,关节名,..." 列表，逐个生成 ros2_control joint 接口。
       清单由 launch 从权威电机拓扑配置生成并注入（control_joints 参数），
       本片段不写死任何关节数量。 -->
  <xacro:macro name="emit_control_joints" params="joints">
    <xacro:if value="${len(joints) > 0}">
      <xacro:canfd_control_joint joint="${joints[0]}"/>
      <xacro:emit_control_joints joints="${joints[1:]}" />
    </xacro:if>
  </xacro:macro>
</robot>
