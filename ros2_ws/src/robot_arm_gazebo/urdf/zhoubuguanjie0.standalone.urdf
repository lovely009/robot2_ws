<?xml version="1.0" encoding="utf-8"?>
<!-- 单文件纯模型 URDF（zhoubuguanjie0：base_link + 4 个 revolute 关节），可直接加载，无需 xacro、无插件。
     由 urdf/zhoubuguanjie0.urdf.xacro 展开后剥掉 ros2_control / gazebo 插件得到；
     网格引用 robot_arm_gazebo 包内 meshes/，加载前需 source 本工作空间。 -->
<robot name="zhoubuguanjie0">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.21733 0.0036622 -0.029183" />
      <mass value="0.87969" />
      <inertia ixx="0.00037639" ixy="0.00037717" ixz="0.00019513" iyy="0.020016" iyz="-3.1635E-06" izz="0.020019" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/base_link.STL" />
      </geometry>
      <material name="base_link_material">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link name="Joint_Link1">
    <inertial>
      <origin rpy="0 0 0" xyz="0.04898 5.1503E-06 -0.014508" />
      <mass value="0.065794" />
      <inertia ixx="2.3442E-05" ixy="2.07E-08" ixz="6.2323E-06" iyy="5.0828E-05" iyz="-1.5091E-09" izz="6.4882E-05" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link1.STL" />
      </geometry>
      <material name="Joint_Link1_material">
        <color rgba="0.52549 0.52549 0.52549 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_link1" type="revolute">
    <origin rpy="-3.1416 0 3.1416" xyz="0 0 -0.0525" />
    <parent link="base_link" />
    <child link="Joint_Link1" />
    <axis xyz="0 0 1" />
    <limit effort="10.0" lower="0" upper="1.57" velocity="1.0" />
  </joint>
  <link name="Joint_Link2">
    <inertial>
      <origin rpy="0 0 0" xyz="-5.4955E-06 -0.00020592 -0.10031" />
      <mass value="0.36781" />
      <inertia ixx="0.00046693" ixy="4.4592E-07" ixz="-8.228E-09" iyy="0.00048641" iyz="-7.4905E-08" izz="0.00010086" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link2.STL" />
      </geometry>
      <material name="Joint_Link2_material">
        <color rgba="0.74902 0.74902 0.74902 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link2.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_link2" type="revolute">
    <origin rpy="3.1416 1.5708 0" xyz="0.0981 0 -0.0245" />
    <parent link="Joint_Link1" />
    <child link="Joint_Link2" />
    <axis xyz="0 0 1" />
    <limit effort="10.0" lower="-1.57" upper="1.57" velocity="1.0" />
  </joint>
  <link name="Joint_Link3">
    <inertial>
      <origin rpy="0 0 0" xyz="5.9219E-06 -0.040547 0.0077112" />
      <mass value="0.13227" />
      <inertia ixx="9.4443E-05" ixy="4.4247E-08" ixz="-4.2648E-09" iyy="4.2E-05" iyz="1.3E-05" izz="0.00011723" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link3.STL" />
      </geometry>
      <material name="Joint_Link3_material">
        <color rgba="0.74902 0.74902 0.74902 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link3.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_link3" type="revolute">
    <origin rpy="1.5708 0 3.1191" xyz="-0.00062082 -0.027543 -0.193" />
    <parent link="Joint_Link2" />
    <child link="Joint_Link3" />
    <axis xyz="0 0 1" />
    <limit effort="10.0" lower="-0.09" upper="2.09" velocity="1.0" />
  </joint>
  <link name="Joint_Link4">
    <inertial>
      <origin rpy="0 0 0" xyz="-4.2921E-05 -4.7189E-05 -0.042603" />
      <mass value="0.16596" />
      <inertia ixx="0.0001447" ixy="-2.1917E-08" ixz="-7.4552E-10" iyy="0.00014473" iyz="-4.863E-08" izz="2.9722E-05" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link4.STL" />
      </geometry>
      <material name="Joint_Link4_material">
        <color rgba="0.74902 0.74902 0.74902 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://robot_arm_gazebo/meshes/Joint_Link4.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint_link4" type="revolute">
    <origin rpy="1.5708 0.79164 -3.1416" xyz="0 -0.0911 0.0245" />
    <parent link="Joint_Link3" />
    <child link="Joint_Link4" />
    <axis xyz="0 0 -1" />
    <limit effort="10.0" lower="-1.57" upper="1.57" velocity="1.0" />
  </joint>
</robot>
