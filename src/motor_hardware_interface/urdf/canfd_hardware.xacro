<?xml version="1.0"?>
<!-- CAN-FD ros2_control 硬件描述片段（与机器人拓扑无关）。

  供机器人模型 xacro include 使用：canfd_hardware 宏展开 CanFdSystem 插件与
  逻辑总线覆盖参数，canfd_control_joint 宏声明 position 命令 + 三态接口。
  关节清单由模型包提供，本片段不写死任何关节、数量或左右臂拓扑。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="canfd_hardware"
               params="left_interface right_interface motor_config_file
                       bus_left:=left_arm bus_right:=right_arm">
    <hardware>
      <plugin>motor_hardware_interface/CanFdSystem</plugin>
      <param name="bus_override.${bus_left}">${left_interface}</param>
      <param name="bus_override.${bus_right}">${right_interface}</param>
      <param name="config_file">${motor_config_file}</param>
    </hardware>
  </xacro:macro>

  <xacro:macro name="canfd_control_joint" params="joint">
    <joint name="${joint}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>
</robot>
