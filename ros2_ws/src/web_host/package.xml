<?xml version="1.0"?>
<package format="3">
  <name>web_host</name>
  <version>0.1.0</version>
  <description>Web 上位机（前端静态资产 + rosbridge + 文件域 API）；台架进程管理在 bench_manager。</description>
  <maintainer email="ly@todo.todo">ly</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>bvh_broadcaster</exec_depend>
  <exec_depend>robot_transmission</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosbridge_library</exec_depend>
  <exec_depend>can_bridge_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>control_msgs</exec_depend>
</package>
