ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
# micro_ros_firmware 本地 CMake host 测试产物。
/micro_ros_firmware/.host-build/
/micro_ros_firmware/test/host/build/
# micro_ros_firmware 本地构建产物（PlatformIO/cmake 生成，禁止入库）。
/micro_ros_firmware/build/
# Claude Code / superpowers 本地会话与缓存。
/.claude/
/.superpowers/
# micro-ROS Agent 独立工作区的构建产物。
micro_ros_agent/build/
micro_ros_agent/install/
micro_ros_agent/log/
# 测试 fixture 目录误跑 colcon 产生的构建产物。
src/motor_hardware_interface/test/fixtures/build/
src/motor_hardware_interface/test/fixtures/install/
src/motor_hardware_interface/test/fixtures/log/
# Brooks-lint 运行历史记录。
/.brooks-lint-history.json
