<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_host</name>
  <version>0.1.0</version>
  <description>Web 上位机（前端静态资产 + rosbridge + 文件域 API）；台架进程管理在 bench_manager。</description>
  <maintainer email="ly@todo.todo">ly</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_transmission</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-canopen</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rosbridge_library</exec_depend>
  <exec_depend>can_bridge_msgs</exec_depend>
  <!-- 命令节拍（ADR 0014）：页面只下设定值，快照流由它出。这条是**真声明**——
       motor_command 只依赖 rclpy/can_bridge_msgs/std_msgs，不成环。 -->
  <exec_depend>motor_command</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- 台架进程管理（bench_manager）不在本包的依赖里：本 launch 只做 L1（rosbridge +
       静态页），编排者是 robot_bringup 的 robot.launch.py。声明它反而会成环
       （bench_manager 依赖 bench_msgs，robot_bringup 依赖两者）。 -->
  <!-- 臂视图和模型 API 读取公共模型，避免依赖仿真运行包。 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
