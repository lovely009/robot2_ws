<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="standard_trajectory_mock">
  <!-- Accept the production launch selectors, but never choose real hardware. -->
  <xacro:arg name="bus_overrides" default=""/>
  <xacro:arg name="motor_config_file" default=""/>
  <xacro:arg name="control_joints" default=""/>
  <link name="base_link"/>
  <link name="mock_link1"/>
  <link name="mock_link2"/>
  <joint name="ecosystem_joint1" type="revolute">
    <parent link="base_link"/><child link="mock_link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2" upper="2" effort="5" velocity="2"/>
  </joint>
  <joint name="ecosystem_joint2" type="revolute">
    <parent link="mock_link1"/><child link="mock_link2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2" upper="2" effort="5" velocity="2"/>
  </joint>
  <ros2_control name="StandardTrajectoryMock" type="system">
    <hardware><plugin>mock_components/GenericSystem</plugin></hardware>
    <joint name="ecosystem_joint1">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="ecosystem_joint2">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </ros2_control>
</robot>
