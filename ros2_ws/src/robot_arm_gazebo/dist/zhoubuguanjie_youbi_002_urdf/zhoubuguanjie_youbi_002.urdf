<?xml version="1.0" encoding="utf-8"?>
<!-- zhoubuguanjie_youbi_002 机械臂 URDF 模型（右臂：R58 肩座 + 6 关节主链，无腕部连杆机构）
     几何/惯性参数由 SolidWorks 模型导出，未做真机标定；
     关节限位/力矩/速度是占位值，接真机前必须按实际机械限位与执行器参数修改；
     网格走同目录 meshes/ 相对路径，整个文件夹可任意搬移；
     碰撞网格在 meshes/collision/（凸分解网络，非可视网格）。
     本模型是纯串联树（无闭环），可直接导入 MuJoCo / PyBullet / Blender。
     ⚠ base_link 碰撞只含安装座支架，不含支撑柱段（见主 URDF 头部说明）。 -->
<robot name="zhoubuguanjie_youbi_002">
