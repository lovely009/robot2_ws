<?xml version="1.0" encoding="utf-8"?>
<!-- robot_leg（单腿：骨盆 base_link → 髋 → 膝 → 踝，6 个主动关节，纯串联无闭环）纯模型 URDF，可直接加载。
     由 urdf/robot_leg.urdf.xacro 以 fixed_base:=false 渲染后剥掉 <ros2_control> 与
     <gazebo> 两块得到，因此不含 world 固定连杆（那是 Gazebo 侧的仿真脚手架）。
     网格走 package://robot_sim/models/robot_leg/meshes/，加载前须 source 本工作空间；
     要脱离 ROS 使用，改用 ../../dist/robot_leg_urdf/ 那份相对路径版本。
     ⚠ 本文件由 tools/regen_derived.py 生成，改主 URDF 后重跑，勿手改。
     ⚠ link 名是 Joint_linkN（大写 L，导出器原样），joint 名是 joint_linkN（小写）——不可同名（SDFormat 里 link 与 joint 共用命名空间）。
     ⚠ 关节限位是**占位值**（导出件 <limit> 全是 0/0/0/0，CAD 未配角度配合），接真机前必须按机械限位替换；力矩/速度取自型号库 motor.yaml。 -->
<robot name="robot_leg">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.023199 0.0016887 0.66288"/>
      <mass value="12.926"/>
      <inertia ixx="1.4969" ixy="-0.00012776" ixz="0.017452" iyy="1.4947" iyz="-0.0005305" izz="0.02659"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_sim/models/robot_leg/meshes/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <link name="Joint_link1">
    <inertial>
      <origin rpy="0 0 0" xyz="0.00053599 -0.0032986 0.02836"/>
      <mass value="0.29343"/>
      <inertia ixx="0.00013848" ixy="-7.5114E-07" ixz="6.551E-06" iyy="0.00017569" iyz="-4.3057E-06" izz="0.00021268"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_sim/models/robot_leg/meshes/Joint_link1.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_sim/models/robot_leg/meshes/collision/Joint_link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_link1" type="revolute">
    <origin rpy="1.4563 0.015566 -1.628" xyz="-0.33849 0.019369 1.1657"/>
    <parent link="base_link"/>
    <child link="Joint_link1"/>
    <axis xyz="0 -0.11422 0.99345"/>
    <limit effort="20" lower="-1.5708" upper="1.5708" velocity="3.1416"/>
    <dynamics damping="0.29845" friction="0"/>
  </joint>
