  <!-- 虚拟曲柄连杆 B，同 crank_a（电机缸半径 16.97 mm，与 A 轴夹角 2.5°）。 -->
  <link
    name="crank_b">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="1e-06" />
      <inertia
        ixx="1e-09"
        ixy="0"
        ixz="0"
        iyy="1e-09"
        iyz="0"
        izz="1e-09" />
    </inertial>
  </link>
  <!-- 摇臂（曲柄）自由度 B，同 joint_crank_a：局部 z = 电机输出轴，rpy 的 x 轴指向零位曲柄销。 -->
  <joint
    name="joint_crank_b"
    type="revolute">
    <origin
      xyz="0.00215385410504 -0.000566808875719 -0.0154781471717"
      rpy="1.8297795274 -1.44309944606 2.79362869275" />
    <parent
      link="Joint_link10_0" />
    <child
      link="crank_b" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.1416"
      upper="3.1416"
      effort="10.0"
      velocity="1.0" />
  </joint>
  <!-- 曲柄销 B，同 Joint_link9。 -->
  <link
    name="Joint_link9_0">
    <inertial>
      <origin
        xyz="-0.00121302171944215 -0.0098254047395599 0.00270309286188255"
        rpy="0 0 0" />
      <mass
        value="0.0027833091093188" />
      <inertia
        ixx="2.85188429504042E-08"
        ixy="8.27180612553028E-25"
        ixz="-1.99557322778418E-23"
        iyy="2.85188429504042E-08"
        iyz="4.54949336904165E-24"
        izz="4.96273868274268E-08" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_gazebo/models/zhoubuguanjie_youbi_001/meshes/Joint_link9_0.STL" />
      </geometry>
      <material
        name="Joint_link9_0_material">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_gazebo/models/zhoubuguanjie_youbi_001/meshes/Joint_link9_0.STL" />
      </geometry>
    </collision>
  </link>
  <!-- 曲柄销 B 固接在曲柄上，同 joint_pin_a。 -->
  <joint
    name="joint_pin_b"
    type="fixed">
    <origin
      xyz="0.0177174910513 -1.43197823746e-05 -0.000204752506436"
      rpy="1.60355162102 -0.0909489449129 1.69130250851" />
    <parent
      link="crank_b" />
    <child
      link="Joint_link9_0" />
  </joint>
  <!-- 曲柄端球铰：连杆这一端是 GE43 关节轴承＝球铰。虚拟连杆放在球心上（零质量、无几何）；
       原 joint_link7 的 (0,0,1) 轴成为球铰第二轴，与上面的 (0,1,0) 正交。
       **支链到此结束 —— 连杆腕端是自由端，不与腕部相连。** 真实闭环由 Gazebo 侧
       <gazebo> 注入的缝合关节实现（见文件末尾的 sdf 注入块）。 -->
  <link
    name="rod_ball_b">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-06" />
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
    </inertial>
  </link>
  <joint
    name="joint_rodball_b"
    type="revolute">
    <origin xyz="0.0024932862582335031 0.0011899147130566606 0.0043019257417176802" rpy="3.1415853071795867 5.3969703706080452e-11 -3.1415853071795867" />
    <parent link="Joint_link9_0" />
    <child link="rod_ball_b" />
    <axis xyz="0 1 0" />
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="1.0" />
  </joint>
  <link
    name="Joint_link7_0">
    <inertial>
      <origin
        xyz="-0.0244734153293439 -0.00225426538894358 -0.00255007069438049"
        rpy="0 0 0" />
      <mass
        value="0.0113435728409495" />
      <inertia
        ixx="2.14786472463899E-07"
        ixy="-2.81675553053796E-07"
        ixz="-1.588449529494E-13"
        iyy="3.24682835361342E-06"
        iyz="-1.45580847810913E-14"
        izz="3.43121117524909E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_gazebo/models/zhoubuguanjie_youbi_001/meshes/Joint_link7_0.STL" />
      </geometry>
      <material
        name="Joint_link7_0_material">
        <color
          rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_gazebo/models/zhoubuguanjie_youbi_001/meshes/Joint_link7_0.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="joint_rod_b"
    type="revolute">
    <origin xyz="0.069428295 -0.004961628 0.003215417" rpy="0 0 0" />
    <parent link="rod_ball_b" />
    <child link="Joint_link7_0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="10.0" velocity="1.0" />
  </joint>
  <!-- 连杆腕端球心的 dummy（零质量占位）：零位下与 joint_dummy_wrist_* 重合。
       Gazebo 的缝合关节与 RViz 的对齐检查都以它为锚。 -->
  <link
    name="dummy_rod_b">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-06" />
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
    </inertial>
  </link>
  <joint
    name="joint_dummy_rod_b"
    type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="Joint_link7_0" />
    <child link="dummy_rod_b" />
  </joint>

  <!-- ===================== Gazebo 侧 SDF 注入 =====================
       URDF 是树：两条支链在连杆腕端是自由端，与腕部模块**没有**连接。Gazebo 里必须把
       这个闭环缝上，否则电机的力矩传不到腕部。下面用 <gazebo> 标签把 SDF 片段注入到
       URDF→SDF 的转换结果里（sdformat 会把无 reference 的 <gazebo> 合并进 model 元素）。

       缝合方式：在连杆腕端球心与腕部模块连接点之间建 **ball 关节**（真实的关节轴承＝球铰，
       3 个转动自由度）。注意：
         * dartsim **不支持**闭环（SDFFeatures 会报 "child link already has a parent joint"），
           必须让 Physics 插件使用 Bullet 引擎 —— 见 worlds/wrist_parallel.sdf；
         * 两端的 fixed 关节必须显式 preserveFixedJoint，否则 sdformat 会把子连杆
           lumping 进父连杆，dummy 与转子连杆都会消失。 -->
  <gazebo reference="joint_motor_a"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_motor_b"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_pin_a"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_pin_b"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_dummy_rod_a"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_dummy_rod_b"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_closure_anchor_a"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_closure_anchor_b"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_dummy_wrist_a"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="joint_dummy_wrist_b"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <!-- 闭环缝合关节：连杆腕端 → 腕部模块。**Bullet 引擎只支持 revolute**（实测 ball /
       universal / revolute2 / prismatic / screw 全部报 "not supported yet"），所以球铰用
       两个正交 revolute 串成（与原模型腕端球铰的分解方式一致，(0,0,1) 与 (0,1,0)）。
       第一个关节把中间连杆 closure_ball_* 挂到连杆末端；第二个把它接到腕部模块，
       于是腕部模块有了第二个父关节 —— Gazebo 在这里把环闭上。 -->
  <gazebo>
    <joint name="closure_a_1" type="revolute">
      <parent>Joint_link7</parent>
      <child>closure_ball_a</child>
      <pose relative_to="closure_ball_a">0 0 0 0 0 0</pose>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.1416</lower><upper>3.1416</upper></limit></axis>
    </joint>
    <joint name="closure_a_2" type="revolute">
      <parent>closure_ball_a</parent>
      <child>Joint_link6</child>
      <pose relative_to="Joint_link6">0.00070789 -0.0098747 0.0065 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><lower>-3.1416</lower><upper>3.1416</upper></limit></axis>
    </joint>
    <joint name="closure_b_1" type="revolute">
      <parent>Joint_link7_0</parent>
      <child>closure_ball_b</child>
      <pose relative_to="closure_ball_b">0 0 0 0 0 0</pose>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.1416</lower><upper>3.1416</upper></limit></axis>
    </joint>
    <joint name="closure_b_2" type="revolute">
      <parent>closure_ball_b</parent>
      <child>Joint_link6</child>
      <pose relative_to="Joint_link6">0.00070789 -0.0098747 -0.033386 0 0 0</pose>
      <axis><xyz>0 1 0</xyz><limit><lower>-3.1416</lower><upper>3.1416</upper></limit></axis>
    </joint>
  </gazebo>

  <!-- ==================== MuJoCo 侧闭环缝合 ====================
       URDF 是树：两条支链在连杆腕端**悬空**，与腕部模块没有连接关系。MuJoCo 用
       <equality><connect> 把两个 site 钉在同一点上 —— 这正是真实的关节轴承（球铰）：
       3 个位置约束、3 个转动自由度全放开。site 名 = 连杆名（mujoco_ros2_control 的
       URDF→MJCF 转换器会 add_links_as_sites，给每个 link 生成同名 site）。
       本块由 mujoco_ros2_control/scripts/robot_description_to_mjcf.sh 在运行期读取，
       <raw_inputs> 的内容会原样拷进生成的 MJCF。

       注意：Gazebo 走不通这条路 —— gz-sim 默认的 dartsim 明确拒绝闭环
       （SDFFeatures: child link already has a parent joint），而 Bullet 引擎虽然支持闭环，
       却**只支持 revolute 一种关节**（ball/universal/revolute2/prismatic/screw 全部
       "not supported yet"），球铰只能用 revolute 串近似。 -->
  <mujoco_inputs>
    <raw_inputs>
      <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81"/>

      <!-- 转换器会给每个连杆生成**两个** geom（class=collision 与 class=visual），
           所以这两个 class 必须在这里定义，否则生成的 MJCF 报
           "unknown default class name"。group 2/3 让 MuJoCo 里能分别开关显示。
           collision 关接触是**有意**的：装配位形下 CAD 里就有 29 对网格互相穿透
           （曲柄销插在关节轴承孔里、肩座插进基座，最深 36.5 mm），开接触必爆
           —— 见仓库根的 MUJOCO_LOG.TXT。density=0 保证质量仍只来自 URDF 的 <inertial>。 -->
      <default>
        <default class="visual">
          <geom group="2" type="mesh" contype="0" conaffinity="0" density="0"/>
        </default>
        <default class="collision">
          <geom group="3" type="mesh" contype="0" conaffinity="0" density="0"/>
        </default>
        <!-- 零质量虚拟连杆（rod_ball_*）与零阻尼会让质量矩阵奇异并发散 -->
        <joint damping="0.5" armature="1e-05" frictionloss="0.005"/>
      </default>

      <equality>
        <connect site1="dummy_rod_a" site2="dummy_wrist_a"
                 solref="0.005 1" solimp="0.95 0.99 0.001"/>
        <connect site1="dummy_rod_b" site2="dummy_wrist_b"
                 solref="0.005 1" solimp="0.95 0.99 0.001"/>
      </equality>

      <!-- 执行器 = 真机 6 台电机。joint_link5/6 与四个球铰轴**不驱动**：它们由连杆带动，
           这正是与 Gazebo 侧（只接管肩肘 4 台）的关键差别。kp/kv 取自
           config/simulation_topology.yaml 的 cerb_r58 plant；腕部两台 X25S 无标定值，占位。 -->
      <actuator>
        <position name="shoulder_yaw"   joint="joint_link1"   kp="30" kv="1"   ctrlrange="-1.5708 1.5708"/>
        <position name="shoulder_roll"  joint="joint_link2"   kp="30" kv="1"   ctrlrange="-1.5708 1.5708"/>
        <position name="shoulder_pitch" joint="joint_link3"   kp="30" kv="1"   ctrlrange="-1.5708 1.5708"/>
        <position name="elbow_pitch"    joint="joint_link4"   kp="30" kv="1"   ctrlrange="-1.5708 1.5708"/>
        <position name="wrist_motor_a"  joint="joint_crank_a" kp="5"  kv="0.2" ctrlrange="-3.1416 3.1416"/>
        <position name="wrist_motor_b"  joint="joint_crank_b" kp="5"  kv="0.2" ctrlrange="-3.1416 3.1416"/>
      </actuator>
    </raw_inputs>
  </mujoco_inputs>
</robot>
