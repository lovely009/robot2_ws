# Non-motion maintenance through the current supervisor. Acceptance is not a
# device completion receipt; retain ConfigRequest.request_id and wait for the
# existing /motor/config_result terminal response. Writes require a healthy
# owned, unarmed, freshly disabled robot. REPORT is read-only.
string lease_id
uint64 epoch
uint64 session_id
can_bridge_msgs/ConfigRequest request
---
bool success
string reason
