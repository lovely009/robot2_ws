<?xml version="1.0" encoding="utf-8"?>
<!-- zhoubuguanjie_youbi_001（右臂肘部以上：肩座 base_link → 肩 ×3 → 肘，4 个主动关节，纯串联无闭环）的 ROS 无关发布件，可脱离 ROS 直接加载。
     由 tools/regen_derived.py 从模型主 URDF 派生，勿手改：
     1. 网格路径由 package://robot_sim/models/zhoubuguanjie_youbi_001/meshes/ 改为相对路径 meshes/...，整个目录可任意搬移；
     2. 不含 <ros2_control> 与 <gazebo> 仿真块，也不含 world 固定连杆。
     几何/惯性取自 SolidWorks 导出（未做真机标定）。关节限位取自 CAD 角度配合（lower/upper 是实值），力矩/速度取自型号库 motor.yaml。 -->
<robot name="zhoubuguanjie_youbi_001">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0062997 1.3878E-17 0.32511"/>
      <mass value="2.2245"/>
      <inertia ixx="0.074937" ixy="-1.3878E-17" ixz="-0.0034459" iyy="0.075863" iyz="1.5125E-18" izz="0.0021441"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <link name="Joint_link1">
    <inertial>
      <origin rpy="0 0 0" xyz="2.5064E-05 0.054055 0.015856"/>
      <mass value="0.07625"/>
      <inertia ixx="5.319E-05" ixy="2.0581E-08" ixz="1.6039E-09" iyy="2.7653E-05" iyz="-6.2322E-06" izz="6.7245E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Joint_link1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.52549 0.52549 0.52549 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/Joint_link1.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_link1" type="revolute">
    <origin rpy="-1.5708 0 1.5708" xyz="0.1595 0 0.571"/>
    <parent link="base_link"/>
    <child link="Joint_link1"/>
    <axis xyz="0 0 -1"/>
    <limit effort="5" lower="-1.5708" upper="1.5708" velocity="3.1416"/>
    <dynamics damping="0.060025" friction="0"/>
  </joint>
  <link name="Joint_link2">
    <inertial>
      <origin rpy="0 0 0" xyz="-7.8249E-06 -0.00078452 -0.10034"/>
      <mass value="0.36781"/>
      <inertia ixx="0.00046692" ixy="6.6991E-09" ixz="6.2336E-09" iyy="0.00048827" iyz="-7.1641E-08" izz="9.901E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Joint_link2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.89804 0.91765 0.92941 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/Joint_link2.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_link2" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0 0.1039 0.0245"/>
    <parent link="Joint_link1"/>
    <child link="Joint_link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="5" lower="-1.5708" upper="1.5708" velocity="3.1416"/>
    <dynamics damping="0.00021527" friction="0"/>
  </joint>
  <link name="Joint_link3">
    <inertial>
      <origin rpy="0 0 0" xyz="-1.7842E-05 -0.046936 0.0090733"/>
      <mass value="0.13227"/>
      <inertia ixx="9.4443E-05" ixy="4.4044E-08" ixz="-4.4851E-09" iyy="4.3848E-05" iyz="1.3E-05" izz="0.00011539"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Joint_link3.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.89804 0.91765 0.92941 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/Joint_link3.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_link3" type="revolute">
    <origin rpy="1.5708 0 3.1416" xyz="0 -0.02755 -0.1872"/>
    <parent link="Joint_link2"/>
    <child link="Joint_link3"/>
    <axis xyz="0 0 -1"/>
    <limit effort="5" lower="-2" upper="2" velocity="3.1416"/>
    <dynamics damping="0.0034783" friction="0"/>
  </joint>
  <link name="Joint_link4">
    <inertial>
      <origin rpy="0 0 0" xyz="-9.6627E-06 -7.7935E-05 -0.037647"/>
      <mass value="0.1555"/>
      <inertia ixx="0.00014237" ixy="-1.2723E-08" ixz="3.268E-08" iyy="0.00014233" iyz="-3.5987E-08" izz="2.5512E-05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Joint_link4.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.89804 0.91765 0.92941 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/Joint_link4.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint_link4" type="revolute">
    <origin rpy="1.5708 0 3.1416" xyz="0 -0.0996 0.0245"/>
    <parent link="Joint_link3"/>
    <child link="Joint_link4"/>
    <axis xyz="0 0 -1"/>
    <limit effort="1.15" lower="-1.5708" upper="1.5708" velocity="4.189"/>
    <dynamics damping="2.5513E-05" friction="0"/>
  </joint>
</robot>
