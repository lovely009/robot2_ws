<?xml version="1.0"?>
<robot name="upper_body_canfd_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find motor_hardware_interface)/urdf/canfd_hardware.xacro"/>
  <!-- CAN-FD 后端的总线覆盖列表："逻辑总线:接口,逻辑总线:接口"（数量任意）。 -->
  <xacro:arg name="bus_overrides"
             default="left_arm:/dev/ttyACM0,right_arm:/dev/ttyACM1"/>
  <xacro:arg name="motor_config_file" default=""/>
  <!-- ros2_control 关节清单：由 launch 从电机拓扑配置生成并注入（逗号分隔）。
       默认值保持与默认 motor_driver.yaml 一致，保证无参数渲染可用。 -->
  <xacro:arg name="control_joints"
             default="left_shoulder_yaw_joint,left_shoulder_roll_joint,left_shoulder_pitch_joint,left_elbow_pitch_joint,left_wrist_yaw_joint,left_wrist_pitch_joint,left_wrist_roll_joint,right_shoulder_yaw_joint,right_shoulder_roll_joint,right_shoulder_pitch_joint,right_elbow_pitch_joint,right_wrist_yaw_joint,right_wrist_pitch_joint,right_wrist_roll_joint"/>
  <xacro:property name="control_joints_value" value="$(arg control_joints)"/>

  <!-- Coordinate convention: +X forward, +Y left, +Z up. -->
  <material name="torso_gray"><color rgba="0.23 0.27 0.32 1"/></material>
  <material name="left_blue"><color rgba="0.10 0.45 0.85 1"/></material>
  <material name="right_orange"><color rgba="0.95 0.42 0.10 1"/></material>
  <material name="joint_dark"><color rgba="0.08 0.09 0.11 1"/></material>

  <xacro:macro name="box_inertia" params="mass x y z ox oy oz">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}" iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${0.4 * mass * radius * radius}" ixy="0" ixz="0"
        iyy="${0.4 * mass * radius * radius}" iyz="0"
        izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia_z" params="mass radius length center_z">
    <inertial>
      <origin xyz="0 0 ${center_z}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3*radius*radius + length*length) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (3*radius*radius + length*length) / 12.0}" iyz="0"
        izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="joint_ball_link" params="name color mass:=0.30 radius:=0.052">
    <link name="${name}">
      <visual>
        <geometry><sphere radius="${radius}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision><geometry><sphere radius="${radius}"/></geometry></collision>
      <xacro:sphere_inertia mass="${mass}" radius="${radius}"/>
    </link>
  </xacro:macro>

  <xacro:macro name="arm" params="side sign arm_color">
    <!-- Shoulder yaw motor. -->
    <xacro:joint_ball_link name="${side}_shoulder_yaw_link" color="joint_dark"/>
    <joint name="${side}_shoulder_yaw_joint" type="revolute">
      <origin xyz="0 ${sign * 0.265} 0.72" rpy="0 0 0"/>
      <parent link="chest_link"/>
      <child link="${side}_shoulder_yaw_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.57" upper="1.57" effort="60" velocity="6"/>
      <dynamics damping="0.06" friction="0.02"/>
    </joint>

    <!-- Shoulder roll motor. -->
    <xacro:joint_ball_link name="${side}_shoulder_roll_link" color="joint_dark"/>
    <joint name="${side}_shoulder_roll_joint" type="revolute">
      <parent link="${side}_shoulder_yaw_link"/>
      <child link="${side}_shoulder_roll_link"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.40" upper="1.40" effort="60" velocity="6"/>
      <dynamics damping="0.06" friction="0.02"/>
    </joint>

    <!-- Shoulder pitch motor; the upper arm hangs along -Z at q=0. -->
    <link name="${side}_upper_arm_link">
      <visual>
        <origin xyz="0 0 -0.15"/>
        <geometry><cylinder radius="0.044" length="0.30"/></geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.15"/>
        <geometry><cylinder radius="0.044" length="0.30"/></geometry>
      </collision>
      <xacro:cylinder_inertia_z mass="1.8" radius="0.044" length="0.30" center_z="-0.15"/>
    </link>
    <joint name="${side}_shoulder_pitch_joint" type="revolute">
      <parent link="${side}_shoulder_roll_link"/>
      <child link="${side}_upper_arm_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.20" upper="2.20" effort="60" velocity="6"/>
      <dynamics damping="0.08" friction="0.025"/>
    </joint>

    <!-- Elbow pitch motor. -->
    <link name="${side}_forearm_link">
      <visual>
        <origin xyz="0 0 -0.135"/>
        <geometry><cylinder radius="0.039" length="0.27"/></geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.135"/>
        <geometry><cylinder radius="0.039" length="0.27"/></geometry>
      </collision>
      <xacro:cylinder_inertia_z mass="1.2" radius="0.039" length="0.27" center_z="-0.135"/>
    </link>
    <joint name="${side}_elbow_pitch_joint" type="revolute">
      <origin xyz="0 0 -0.30" rpy="0 0 0"/>
      <parent link="${side}_upper_arm_link"/>
      <child link="${side}_forearm_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="2.55" effort="60" velocity="7"/>
      <dynamics damping="0.06" friction="0.02"/>
    </joint>

    <!-- 25/30 mm integrated motor N=1: wrist yaw. -->
    <xacro:joint_ball_link name="${side}_wrist_yaw_link" color="joint_dark" mass="0.22" radius="0.038"/>
    <joint name="${side}_wrist_yaw_joint" type="revolute">
      <origin xyz="0 0 -0.27" rpy="0 0 0"/>
      <parent link="${side}_forearm_link"/>
      <child link="${side}_wrist_yaw_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.75" upper="1.75" effort="5" velocity="12"/>
      <dynamics damping="0.025" friction="0.01"/>
    </joint>

    <!-- 25/30 mm integrated motor N=2: wrist pitch. -->
    <xacro:joint_ball_link name="${side}_wrist_pitch_link" color="joint_dark" mass="0.20" radius="0.034"/>
    <joint name="${side}_wrist_pitch_joint" type="revolute">
      <origin xyz="0 0 -0.045" rpy="0 0 0"/>
      <parent link="${side}_wrist_yaw_link"/>
      <child link="${side}_wrist_pitch_link"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.25" upper="1.25" effort="5" velocity="12"/>
      <dynamics damping="0.025" friction="0.01"/>
    </joint>

    <!-- 25/30 mm integrated motor N=3: wrist roll + hand. -->
    <link name="${side}_hand_link">
      <visual>
        <origin xyz="0 0 -0.075"/>
        <geometry><box size="0.075 0.12 0.15"/></geometry>
        <material name="${arm_color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.075"/>
        <geometry><box size="0.075 0.12 0.15"/></geometry>
      </collision>
      <xacro:box_inertia mass="0.45" x="0.075" y="0.12" z="0.15" ox="0" oy="0" oz="-0.075"/>
    </link>
    <joint name="${side}_wrist_roll_joint" type="revolute">
      <origin xyz="0 0 -0.043" rpy="0 0 0"/>
      <parent link="${side}_wrist_pitch_link"/>
      <child link="${side}_hand_link"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.80" upper="2.80" effort="5" velocity="14"/>
      <dynamics damping="0.02" friction="0.008"/>
    </joint>
  </xacro:macro>

  <!-- Heavy pedestal gives the half-body a stable laboratory base without an external mesh. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.50 0.70 0.14"/></geometry>
      <material name="torso_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.07"/>
      <geometry><box size="0.50 0.70 0.14"/></geometry>
    </collision>
    <xacro:box_inertia mass="55" x="0.50" y="0.70" z="0.14" ox="0" oy="0" oz="0.07"/>
  </link>

  <link name="chest_link">
    <visual>
      <origin xyz="0 0 0.41"/>
      <geometry><box size="0.22 0.42 0.82"/></geometry>
      <material name="torso_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.41"/>
      <geometry><box size="0.22 0.42 0.82"/></geometry>
    </collision>
    <xacro:box_inertia mass="18" x="0.22" y="0.42" z="0.82" ox="0" oy="0" oz="0.41"/>
  </link>
  <joint name="base_to_chest" type="fixed">
    <origin xyz="0 0 0.14"/>
    <parent link="base_link"/>
    <child link="chest_link"/>
  </joint>

  <link name="head_dummy_link">
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><sphere radius="0.10"/></geometry>
      <material name="torso_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><sphere radius="0.10"/></geometry>
    </collision>
    <xacro:sphere_inertia mass="1.2" radius="0.10"/>
  </link>
  <joint name="chest_to_head_dummy" type="fixed">
    <origin xyz="0 0 0.86"/>
    <parent link="chest_link"/>
    <child link="head_dummy_link"/>
  </joint>

  <xacro:arm side="left" sign="1" arm_color="left_blue"/>
  <xacro:arm side="right" sign="-1" arm_color="right_orange"/>

  <ros2_control name="UpperBodyCanFdSystem" type="system">
    <xacro:canfd_hardware bus_overrides="$(arg bus_overrides)"
                          motor_config_file="$(arg motor_config_file)"/>
    <xacro:emit_control_joints
        joints="${[j.strip() for j in control_joints_value.split(',') if j]}"/>
  </ros2_control>
</robot>
