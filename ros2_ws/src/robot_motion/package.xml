<?xml version="1.0"?>
<package format="3">
  <name>robot_motion</name>
  <version>0.1.0</version>
  <description>Supervised standard trajectory actions executed by the micro-ROS MCU.</description>
  <maintainer email="dev@robot.local">robot dev</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>motor_hardware_interface</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>can_bridge_msgs</exec_depend>
  <exec_depend>robot_transmission</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>unique_identifier_msgs</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>std_srvs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
