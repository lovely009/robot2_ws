<?xml version="1.0"?>
<package format="3">
  <name>motor_canfd_sim</name>
  <version>0.1.0</version>
  <description>C++ CAN-FD motor-side simulator and Gazebo bridge using motor_canfd_drive codecs.</description>
  <maintainer email="robot@example.com">Robot Developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>motor_canfd_drive</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>motor_hardware_interface</exec_depend>
  <exec_depend>upper_body_canfd_gazebo</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
