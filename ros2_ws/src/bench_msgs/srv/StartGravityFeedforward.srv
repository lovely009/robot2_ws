# 启动重力前馈叠加节点（bench-gravity-feedforward.service）。
#
# 用于由 micro_ros_bridge 向 STM32 转发命令的会话。
string model             # robot_description 安装树须包含 models/<model>/urdf/<model>.urdf
string joint_map         # motor_id:关节名 逗号分隔，由前端按模型算出（权威在 web_host）
float64 effort_gain      # 乘在 τ_g 上；0 = 逐字段直通（多一跳但没补）
---
bool ok
string error
string status_json
