    <limit
      lower="-3.1416"
      upper="3.1416"
      effort="10.0"
      velocity="1.0" />
  </joint>
  <!-- 曲柄销：GE43 关节轴承 + 半圆头螺钉，压装在曲柄上，随曲柄绕电机输出轴公转。 -->
  <link
