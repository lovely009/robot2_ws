  <!-- 腕部模块的两个连接点 dummy（零质量占位）。零位下分别与 joint_dummy_rod_a/_b 的世界
       位置**逐位重合** —— 这是「支链末端与腕部连接点视觉对齐」的锚点，也是 RViz 对齐检查的判据。
       腕部姿态由 joint_link5（虚拟 YAW，绕竖直轴）+ joint_link6（虚拟 PITCH，绕水平轴）
       两个被动关节描述，角度由 wrist_parallel_fk 节点按两个电机的实际角度解算后写进 /joint_states。 -->
  <link
    name="dummy_wrist_a">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-06" />
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
    </inertial>
  </link>
  <joint
    name="joint_dummy_wrist_a"
    type="fixed">
    <origin xyz="0.00070789 -0.0098747 0.0065" rpy="0 0 0" />
    <parent link="Joint_link6" />
    <child link="dummy_wrist_a" />
  </joint>
  <link
    name="closure_ball_a">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-06" />
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
    </inertial>
  </link>
  <!-- 这个 fixed 关节只在 URDF（树）里给中间连杆一个位置；Gazebo 侧会被下面注入的
       closure_*_1 重新挂到连杆末端，于是它有了两个父关节 —— 闭环就在此处形成。 -->
  <joint
    name="joint_closure_anchor_a"
    type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="dummy_wrist_a" />
    <child link="closure_ball_a" />
  </joint>
  <link
    name="dummy_wrist_b">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-06" />
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
    </inertial>
  </link>
  <joint
    name="joint_dummy_wrist_b"
    type="fixed">
    <origin xyz="0.00070789 -0.0098747 -0.033386" rpy="0 0 0" />
    <parent link="Joint_link6" />
    <child link="dummy_wrist_b" />
  </joint>
  <link
    name="closure_ball_b">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1e-06" />
      <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
    </inertial>
  </link>
  <!-- 这个 fixed 关节只在 URDF（树）里给中间连杆一个位置；Gazebo 侧会被下面注入的
       closure_*_1 重新挂到连杆末端，于是它有了两个父关节 —— 闭环就在此处形成。 -->
  <joint
    name="joint_closure_anchor_b"
    type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="dummy_wrist_b" />
    <child link="closure_ball_b" />
  </joint>
  <!-- 腕部连杆A 的球铰虚拟连杆（零质量、无几何、不参与碰撞）。
       真实机构里连杆两端都是关节轴承（GE43 向心关节轴承）＝球铰，SolidWorks 的树导出
       只能给单轴 revolute，于是 joint_link7 只是球铰的一个轴。本连杆与其上的
       joint_wrist_ball_a（轴与 joint_link7 正交，且垂直于连杆轴向）合起来
       构成二自由度球铰；被动角由 wrist_closure_solver.py 按闭环约束解出。
       本连杆是纯运动学占位，质量取 1e-6 kg 只为让 Gazebo 接受。

       ⚠ 这两个轴的 <limit> 放到 ±π 是**有意**的：它们是球铰的分解角，不是物理量 ——
       一个球铰没有「分别限制两个分解角」这回事，而这对分解在腕部行程边缘会接近奇异
       （实测 ±90° 行程内 α 可达 176°，而连杆轴向的真实摆动只有 98°）。限死在 ±1.0
       会把这个奇异当成超限，把本来精确可解的位形夹出 67 mm 的位置残差。真正的安全网
       是求解器的几何可行性判据（「曲柄圆 ∩ 杆长球面」无解即夹紧告警）。 -->
  <!-- 电机A 固定在小臂上：真实机构里 X25S 的安装面贴死 Joint_link4（装配位形下两面
       最小间距 0.13 mm）。SW2URDF 只能导出树，过去把这条边切在别处、让电机挂到连杆
       末端，于是「电机随连杆甩出去」。本关节把电机挂回小臂，位姿与真实装配一致。
       origin 取零位时 Joint_link10 在 Joint_link4 系里的位姿，因此**零位几何与改写前
       逐位相同**（由 test_wrist_closure.py 的零位自检与 test_model_consistency.py 兜底）。 -->
  <joint
    name="joint_motor_a"
    type="fixed">
    <origin
      xyz="-0.00290823242838 0.0179657756876 -0.0370047460742"
      rpy="-1.57072810389 1.46386637316 -0.117728514829" />
    <parent
      link="Joint_link4" />
    <child
      link="Joint_link10" />
  </joint>
  <link
    name="Joint_link10">
    <inertial>
      <origin
        xyz="-0.00371036240883221 -0.00044916464990169 -0.0168234416979805"
        rpy="0 0 0" />
      <mass
        value="0.00539494244793398" />
      <inertia
        ixx="5.25985392228757E-07"
        ixy="-1.4725524972567E-08"
        ixz="-3.83117114060201E-11"
        iyy="6.75759654107736E-07"
        iyz="-1.93244290862971E-09"
        izz="6.54270247068943E-07" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_gazebo/models/zhoubuguanjie_youbi_001/meshes/Joint_link10.STL" />
      </geometry>
      <material
        name="Joint_link10_material">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://robot_arm_gazebo/models/zhoubuguanjie_youbi_001/meshes/Joint_link10.STL" />
      </geometry>
    </collision>
  </link>
  <!-- 虚拟曲柄连杆：真实机构里「电机转子 + 输出法兰 + 销」是一个绕电机输出轴回转的
       刚体，CAD 里没有单独零件（合在 X25S 装配体里），这里用零质量、无几何的连杆占位，
       只为把**真实轴线**表达进树里。零质量占位同 wrist_ball_a：1e-6 kg 只为让 Gazebo 接受。
       本连杆的局部 z 轴 = 电机输出轴（方向由 X25S mesh 圆柱拟合实测，缸半径 17.04 mm、
       离世界竖直 13.4°；两台电机轴互相平行、夹角 2.5°）。 -->
  <link
    name="crank_a">
    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <mass
        value="1e-06" />
      <inertia
        ixx="1e-09"
        ixy="0"
        ixz="0"
        iyy="1e-09"
        iyz="0"
        izz="1e-09" />
    </inertial>
  </link>
  <!-- 摇臂（曲柄）自由度：曲柄连杆相对电机本体绕**电机输出轴**转动。origin 放在电机
       圆柱拟合轴心上，局部 z 即输出轴，故 axis 就是 (0,0,1)；rpy 取「x 轴指向零位时的
       曲柄销」，于是 φ=0 就是装配位形。零位几何因此与改写前逐位相同。
       ⚠ 历史文档（README「已知问题 2」与 2026-10-10 报告 §2）称「电机回转轴是局部 z、
       离竖直 75°、摇臂轴与输出轴不是同一根、中间还有一级直角传动」——那是把 mesh 的
       法向统计读错了轴，**该结论已作废**。 -->
  <joint
    name="joint_crank_a"
    type="revolute">
    <origin
      xyz="-0.00225840153701 8.47458548841e-05 -0.0177987642911"
      rpy="-1.1567128603 -1.48687657556 -0.27843411856" />
    <parent
      link="Joint_link10" />
    <child
