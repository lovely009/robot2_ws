<?xml version="1.0"?>
<!-- 仿真薄壳：引入 SolidWorks 导出的原始 URDF，并注入 ros2_control 与 gz_ros2_control 插件。
     display.launch.py 直接加载 zhoubuguanjie0.urdf（无需控制器），gazebo.launch.py 加载本文件。 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zhoubuguanjie0">
  <xacro:arg name="controllers_file" default="$(find robot_arm_gazebo)/config/controllers.yaml"/>
  <xacro:include filename="$(find robot_arm_gazebo)/urdf/zhoubuguanjie0.urdf"/>

  <ros2_control name="zhoubuguanjie0_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_link1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_link2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_link3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_link4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>
</robot>
