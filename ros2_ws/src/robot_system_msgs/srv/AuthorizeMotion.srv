# One-use permission for a specific standard FollowJointTrajectory goal UUID.
# Does not acquire/renew a lease, arm drives, or enable policy. The goal itself
# still uses control_msgs/action/FollowJointTrajectory without private fields.
std_msgs/Header header
string lease_id
uint64 epoch
uint64 session_id
uint64 sequence
uint8[16] goal_id
---
bool success
string reason
